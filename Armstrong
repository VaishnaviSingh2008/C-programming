#include<stdio.h>

int main() {
    int n,i,c,remainder,sum;

    for(i=1;i<=100;i++) {
        c=i;
        sum=0;

        while(c>0) {
            remainder=c%10;
            sum+=remainder*remainder*remainder;
            c=c/10;
        }

        if(sum==i)
            printf("%d ",i);
    }

    return 0;
}
