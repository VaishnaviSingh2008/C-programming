#include<stdio.h>

int main() {
    int a[5],b[5],c[5],i;

    printf("Enter elements of first array:\n");
    for(i=0;i<5;i++)
        scanf("%d",&a[i]);

    printf("Enter elements of second array:\n");
    for(i=0;i<5;i++)
        scanf("%d",&b[i]);

    for(i=0;i<5;i++)
        c[i]=a[i]+b[i];

    printf("Sum of arrays:\n");
    for(i=0;i<5;i++)
        printf("%d ",c[i]);

    return 0;
}
