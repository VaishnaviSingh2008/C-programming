#include<stdio.h>

int main() {
    int a[10][10], i, j, m, n, sum=0;

    printf("Enter rows and columns: ");
    scanf("%d%d",&m,&n);

    if(m!=n) {
        printf("Diagonal sum is possible only for a square matrix.");
        return 0;
    }

    printf("Enter matrix elements:\n");
    for(i=0;i<m;i++)
        for(j=0;j<n;j++)
            scanf("%d",&a[i][j]);

    for(i=0;i<m;i++)
        sum += a[i][i];

    printf("Sum of diagonal elements = %d",sum);

    return 0;
}
